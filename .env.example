# ==================================================
# Django core
# ==================================================
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Which settings file to use
# dev for local development
# prod for production
DJANGO_SETTINGS_MODULE=config.settings.dev


# ==================================================
# Database (PostgreSQL)
# ==================================================
# Local Docker example:
# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://app:app@db:5432/app


# ==================================================
# Redis (Celery broker + backend)
# ==================================================
REDIS_URL=redis://redis:6379/0


# ==================================================
# Email
# ==================================================
# Dev uses console backend automatically
# Prod should override with real SMTP settings
DEFAULT_FROM_EMAIL=admin@example.com


# ==================================================
# AWS S3 (MEDIA uploads only – prod)
# ==================================================
# Required only in production
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=eu-central-1

# If you use IAM roles on EC2, you can omit these in prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# ==================================================
# Security / CSRF (prod)
# ==================================================
# Comma-separated list of trusted origins
# Example:
# https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=


# Celery
CELERY_BEAT_SCHEDULE_FILE=var/celery/celerybeat-schedule